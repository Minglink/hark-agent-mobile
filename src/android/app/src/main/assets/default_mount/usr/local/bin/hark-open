#!/bin/sh
# hark-open — MinisApp URL interceptor for the PRoot sandbox.
#
# Stands in for xdg-open / sensible-browser / www-browser / BROWSER, and also
# doubles as the in-app preview opener for chat resources. Any argument is
# emitted to stdout wrapped in an OSC 1337 escape sequence that the MinisApp
# host parses and routes to the appropriate built-in viewer:
#
#   * http:// https:// about:*                 → in-app WebView preview
#   * /var/hark/<host>/<path>  (absolute)     → converted to hark://<host>/<path>
#     hark://attachments/...  hark://workspace/...  hark://shared/... etc.
#                                              → routed by extension:
#                                                 images → image viewer
#                                                 markdown → markdown preview
#                                                 html → html preview
#                                                 pdf/office → document preview
#                                                 audio/video → media player
#                                                 else → share sheet
#
# Protocol: ESC ] 1337 ; MinisOpenURL = <url> BEL
#   - ESC = 0x1B, BEL = 0x07
#   - Host scanner strips the whole sequence from the displayed output.
#
# Exit 0 always when we emitted something: the caller should believe the
# viewer was opened.

set -e

ESC=$(printf '\033')
BEL=$(printf '\007')

emit_marker() {
    printf '%s]1337;MinisOpenURL=%s%s\n' "$ESC" "$1" "$BEL"
}

emit() {
    case "$1" in
        http://*|https://*|about:*)
            emit_marker "$1"
            printf 'Opened in Minis browser: %s\n' "$1"
            ;;
        hark://*)
            # Already a hark:// URL — pass through.
            emit_marker "$1"
            printf 'Opened in Minis preview: %s\n' "$1"
            ;;
        /var/hark/*)
            # Convert /var/hark/<host>/<path> → hark://<host>/<path>
            # so the host can resolve it to the real sandbox location and
            # pick the right in-app preview by extension.
            rel="${1#/var/hark/}"
            case "$rel" in
                */*)
                    host="${rel%%/*}"
                    path="${rel#*/}"
                    emit_marker "hark://$host/$path"
                    printf 'Opened in Minis preview: hark://%s/%s\n' "$host" "$path"
                    ;;
                *)
                    # e.g. /var/hark/workspace with no trailing path — a bare
                    # directory. Not previewable; treat as non-URL.
                    printf 'hark-open: not a previewable resource: %s\n' "$1" >&2
                    return 0
                    ;;
            esac
            ;;
        *)
            # Non-URL, non-/var/hark path: print a hint but don't fail — mimic
            # xdg-open best-effort so shell scripts that chain it don't abort.
            printf 'hark-open: not a URL or chat resource, ignoring: %s\n' "$1" >&2
            return 0
            ;;
    esac
}

if [ $# -eq 0 ]; then
    echo "Usage: hark-open <url-or-path>" >&2
    echo "  url-or-path: http(s):// URL, hark:// URL, or /var/hark/<host>/<path>" >&2
    exit 1
fi

for arg in "$@"; do
    emit "$arg"
done

exit 0
